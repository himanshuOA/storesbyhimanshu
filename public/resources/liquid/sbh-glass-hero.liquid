{% comment %}
  Liquid Glass Hero — by StoresByHimanshu
  Add to: sections/sbh-glass-hero.liquid (Shopify 2.0 theme)
{% endcomment %}

<section class="sbh-hero" style="--sbh-accent: {{ section.settings.accent }};">
  {% if section.settings.image %}
    {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'sbh-hero__bg', loading: 'eager', alt: '' }}
  {% endif %}
  <div class="sbh-hero__glass">
    {% if section.settings.eyebrow != blank %}<p class="sbh-hero__eyebrow">{{ section.settings.eyebrow }}</p>{% endif %}
    <h1 class="sbh-hero__title">{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}<div class="sbh-hero__text">{{ section.settings.text }}</div>{% endif %}
    {% if section.settings.button_label != blank %}
      <a class="sbh-hero__btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

<style>
  .sbh-hero { position: relative; min-height: 80vh; display: grid; place-items: center; padding: 48px 16px; overflow: hidden; background: #1c1210; }
  .sbh-hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sbh-hero__glass { position: relative; max-width: 640px; text-align: center; padding: 48px 36px; border-radius: 32px;
    background: linear-gradient(145deg, rgba(255,255,255,.22), rgba(255,255,255,.08));
    border: 1px solid rgba(255,255,255,.35);
    backdrop-filter: blur(22px) saturate(150%); -webkit-backdrop-filter: blur(22px) saturate(150%);
    box-shadow: inset 0 1px 0 rgba(255,255,255,.5), 0 30px 60px rgba(0,0,0,.3); color: #fff; }
  .sbh-hero__eyebrow { letter-spacing: 4px; text-transform: uppercase; font-size: 13px; margin: 0 0 12px; opacity: .85; }
  .sbh-hero__title { font-size: clamp(36px, 6vw, 64px); line-height: 1.05; margin: 0 0 16px; color: #fff; }
  .sbh-hero__text { font-size: 18px; opacity: .9; margin-bottom: 24px; }
  .sbh-hero__btn { display: inline-block; padding: 14px 30px; border-radius: 999px; background: var(--sbh-accent); color: #1c1210; text-decoration: none; font-weight: 600; }
</style>

{% schema %}
{
  "name": "SBH Glass Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Small text", "default": "New collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to be noticed" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your customers what makes this collection special.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "accent", "label": "Button color", "default": "#e3b04b" }
  ],
  "presets": [{ "name": "SBH Glass Hero" }]
}
{% endschema %}
